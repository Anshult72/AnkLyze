{
  "name": "anklyze-backend",
  "version": "1.0.0",
  "description": "ANKLYZE Examination Evaluation Platform - Backend Foundation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx src/tests/auth.test.ts",
    "test:exam": "tsx src/tests/exam.test.ts",
    "test:rubric": "tsx src/tests/rubric.test.ts",
    "test:script": "tsx src/tests/script.test.ts",
    "test:ocr": "tsx src/tests/ocr.test.ts",
    "test:reconstruction": "tsx src/tests/reconstruction.test.ts",
    "test:evaluation": "tsx src/tests/evaluation.test.ts",
    "test:decision": "tsx src/tests/decisionLifecycle.test.ts",
    "test:risk": "tsx src/tests/riskEngine.test.ts",
    "test:moderation": "tsx src/tests/moderationAnalytics.test.ts",
    "test:result": "tsx src/tests/resultRevaluation.test.ts",
    "test:security": "tsx src/tests/securityHardening.test.ts",
    "test:realtime": "tsx src/tests/realtimeSocket.test.ts",
    "test:workflow": "tsx src/tests/secondEvaluationWorkflow.test.ts",
    "test:dashboards": "tsx src/tests/roleDashboards.test.ts",
    "test:all": "npm run test:auth && npm run test:exam && npm run test:rubric && npm run test:script && npm run test:ocr && npm run test:reconstruction && npm run test:evaluation && npm run test:decision && npm run test:risk && npm run test:moderation && npm run test:result && npm run test:security && npm run test:realtime && npm run test:workflow && npm run test:dashboards",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "anklyze",
    "examination",
    "evaluation",
    "prisma",
    "express"
  ],
  "author": "ANKLYZE Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@google-cloud/vision": "^6.1.1",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
