# ==============================================================================
# ANKLYZE Backend Environment Configuration (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env and supply actual local or Neon credentials.
# Do NOT commit production secrets to version control.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Allowed Frontend Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection (Neon or local PostgreSQL)
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anklyze_db?schema=public"

# Authentication & JWT Configuration
# Generate 32+ character high-entropy random keys for production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET="anklyze_jwt_access_dev_secret_key_minimum_32_chars_2026"
JWT_REFRESH_SECRET="anklyze_jwt_refresh_dev_secret_key_minimum_32_chars_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Phase 6: AI Rubric Engine Configuration
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_REQUEST_TIMEOUT_MS=20000
RUBRIC_PROMPT_VERSION=rubric-analysis-v1

# Phase 7: Answer Script Storage Configuration (Cloudinary / Mock)
# Storage provider: 'cloudinary' for real cloud uploads, 'mock' for local/testing
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_SCRIPT_FILE_SIZE_BYTES=26214400

# Phase 8: OCR & Document Processing Configuration (Google Cloud Vision / Mock)
# OCR provider: 'google-vision' for Google Cloud Vision API, 'mock' for hermetic/offline
OCR_PRIMARY_PROVIDER=google-vision
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VISION_API_KEY=
OCR_REQUEST_TIMEOUT_MS=25000
OCR_PIPELINE_VERSION=ocr-v1

# Phase 9 & 10: Multimodal AI Configuration (Reconstruction & Answer Evaluation)
GEMINI_VISION_MODEL=gemini-2.5-flash
GROQ_VISION_MODEL=qwen/qwen3.8-27b
RECONSTRUCTION_PROMPT_VERSION=reconstruct-v1
RECONSTRUCTION_PIPELINE_VERSION=reconstruct-pipeline-v1
RECONSTRUCTION_TIMEOUT_MS=25000
EVALUATION_PROMPT_VERSION=evaluation-v1
EVALUATION_PIPELINE_VERSION=evaluation-pipeline-v1
EVALUATION_TIMEOUT_MS=30000


